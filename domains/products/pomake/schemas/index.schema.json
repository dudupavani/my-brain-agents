{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dudupavani/my-brain-agents/blob/main/domains/products/pomake/schemas/index.schema.json",
  "title": "Pomake design and generated post index",
  "type": "object",
  "additionalProperties": false,
  "required": ["indexVersion", "designs"],
  "properties": {
    "indexVersion": {
      "const": 1
    },
    "designs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/design"
      }
    }
  },
  "$defs": {
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designId",
        "designSourcePath",
        "designOperationalPath",
        "sourceVersions",
        "posts"
      ],
      "properties": {
        "designId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "designSourcePath": {
          "type": "string",
          "pattern": "^designs/[^/]+/design\\.source\\.json$"
        },
        "designOperationalPath": {
          "type": "string",
          "pattern": "^designs/[^/]+/design\\.json$"
        },
        "sourceVersions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["designVersionId", "path"],
            "properties": {
              "designVersionId": {
                "type": "string",
                "pattern": "^version-[0-9a-f]{16}$"
              },
              "path": {
                "type": "string",
                "pattern": "^designs/[^/]+/(design\\.source\\.json|versions/version-[0-9a-f]{16}\\.source\\.json)$"
              }
            }
          }
        },
        "posts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "generationId",
              "designVersionId",
              "pngPath",
              "manifestPath"
            ],
            "properties": {
              "generationId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "designVersionId": {
                "type": "string",
                "pattern": "^version-[0-9a-f]{16}$"
              },
              "pngPath": {
                "type": "string",
                "pattern": "^generated/[^/]+/[^/]+--[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.png$"
              },
              "manifestPath": {
                "type": "string",
                "pattern": "^generated/[^/]+/[^/]+--[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.manifest\\.json$"
              }
            }
          }
        }
      }
    }
  }
}
