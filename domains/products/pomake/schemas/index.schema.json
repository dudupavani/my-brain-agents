{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dudupavani/my-brain-agents/blob/main/domains/products/pomake/schemas/index.schema.json",
  "title": "Pomake design and generated post index",
  "type": "object",
  "additionalProperties": false,
  "required": ["indexVersion", "designs"],
  "properties": {
    "indexVersion": {
      "const": 1
    },
    "designs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/design"
      }
    }
  },
  "$defs": {
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designId", "versions"],
      "properties": {
        "designId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designVersionId", "designSourcePath", "designJsonPath", "posts"],
      "properties": {
        "designVersionId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "designSourcePath": {
          "type": "string",
          "pattern": "^designs/[^/]+/versions/[^/]+/design\\.source\\.json$"
        },
        "designJsonPath": {
          "type": "string",
          "pattern": "^designs/[^/]+/versions/[^/]+/design\\.json$"
        },
        "posts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/post"
          }
        }
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationId", "designVersionId", "pngPath"],
      "properties": {
        "generationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "designVersionId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "pngPath": {
          "type": "string",
          "pattern": "^generated/[^/]+/[^/]+--[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.png$"
        }
      }
    }
  }
}
