{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dudupavani/my-brain-agents/blob/main/domains/products/pomake/schemas/generation-manifest.schema.json",
  "title": "Pomake generatedAssets record",
  "type": "object",
  "additionalProperties": false,
  "required": ["generationId", "designVersionId", "path"],
  "properties": {
    "designVersionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$"
    },
    "generationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "path": {
      "type": "string",
      "pattern": "^generated/[^/]+/[^/]+--[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.png$"
    }
  }
}
